{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ocr-automation.local/schemas/feature-manifest-1.0.json",
  "title": "OCR Automation Feature Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_schema_version",
    "feature_id",
    "display_name",
    "version",
    "description",
    "publisher",
    "entry_point",
    "minimum_core_version",
    "api_contract_version",
    "dependencies",
    "permissions",
    "configuration_schema",
    "ui",
    "data_schema_version"
  ],
  "properties": {
    "manifest_schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "feature_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "entry_point": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*:[A-Za-z_][A-Za-z0-9_]*$"
    },
    "minimum_core_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "maximum_core_version": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "api_contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "features",
        "services"
      ],
      "properties": {
        "features": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "version": {
                "type": "string",
                "pattern": "^(?:[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?|[0-9]+\\.x|[0-9]+\\.[0-9]+\\.x)$"
              }
            }
          }
        },
        "services": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "pattern": "^(?:[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?|[0-9]+\\.x|[0-9]+\\.[0-9]+\\.x)$"
              }
            }
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "configuration_schema": {
      "type": "string",
      "minLength": 1
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "navigation_label",
        "icon",
        "workspace"
      ],
      "properties": {
        "navigation_label": {
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "type": "string",
          "minLength": 1
        },
        "workspace": {
          "type": "string",
          "pattern": "^ui:[A-Za-z_][A-Za-z0-9_]*$"
        }
      }
    },
    "license_entitlement": {
      "type": [
        "string",
        "null"
      ]
    },
    "data_schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "publisher_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,63}$"
    }
  }
}
