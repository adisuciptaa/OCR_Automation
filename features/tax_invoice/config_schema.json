{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ocr-automation.local/features/tax_invoice/configuration-1.0.json",
  "title": "Tax Invoice Reader Configuration",
  "description": "Konfigurasi deteksi, OCR, batas pemrosesan, dan pemetaan hasil tervalidasi ke workbook Excel.",
  "type": "object",
  "x-config-version": 1,
  "additionalProperties": false,
  "properties": {
    "detection": {
      "type": "object",
      "default": {
        "top_region_ratio": 0.25,
        "marker_phrases": [
          "FAKTUR PAJAK",
          "FAKTURPAJAK"
        ],
        "fallback_full_page": false
      },
      "additionalProperties": false,
      "properties": {
        "top_region_ratio": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 0.75,
          "default": 0.25,
          "description": "Proporsi tinggi halaman dari sisi atas yang dipindai untuk marker utama."
        },
        "marker_phrases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "default": [
            "FAKTUR PAJAK",
            "FAKTURPAJAK"
          ],
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80
          },
          "description": "Daftar frasa yang menjadi indikator kandidat halaman faktur pajak."
        },
        "fallback_full_page": {
          "type": "boolean",
          "default": false,
          "description": "Jika true, izinkan pemeriksaan seluruh halaman ketika marker tidak ditemukan pada area atas."
        }
      }
    },
    "ocr": {
      "type": "object",
      "default": {
        "prefer_embedded_text": true,
        "language": "ind+eng"
      },
      "additionalProperties": false,
      "properties": {
        "prefer_embedded_text": {
          "type": "boolean",
          "default": true,
          "description": "Gunakan teks tertanam PDF jika tersedia sebelum menjalankan OCR gambar."
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32,
          "default": "ind+eng",
          "description": "Kode bahasa engine OCR; ketersediaan traineddata diverifikasi oleh adapter OCR saat eksekusi."
        }
      }
    },
    "processing": {
      "type": "object",
      "default": {
        "max_pages_per_document": 200,
        "render_dpi": 200
      },
      "additionalProperties": false,
      "properties": {
        "max_pages_per_document": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000,
          "default": 200,
          "description": "Batas jumlah halaman per dokumen untuk mengendalikan waktu dan penggunaan sumber daya."
        },
        "render_dpi": {
          "type": "integer",
          "minimum": 100,
          "maximum": 400,
          "default": 200,
          "description": "Resolusi render halaman PDF untuk OCR; dibatasi oleh resource limit adapter PDF."
        }
      }
    },
    "excel": {
      "type": [
        "object",
        "null"
      ],
      "description": "Pemetaan opsional. Jika tidak disediakan, ekstraksi tetap berjalan tanpa menghasilkan workbook.",
      "additionalProperties": false,
      "properties": {
        "source_workbook_path": {
          "type": "string",
          "minLength": 1,
          "description": "Path workbook sumber; workbook ini tidak pernah ditimpa."
        },
        "worksheet": {
          "type": "string",
          "minLength": 1
        },
        "header_row": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "data_start_row": {
          "type": "integer",
          "minimum": 1
        },
        "source_key_column": {
          "type": "string",
          "minLength": 1
        },
        "target_column": {
          "type": "string",
          "minLength": 1
        },
        "match_field": {
          "type": "string",
          "enum": [
            "invoice_number",
            "tax_invoice_number"
          ]
        },
        "write_field": {
          "type": "string",
          "enum": [
            "invoice_number",
            "tax_invoice_number"
          ]
        },
        "key_type": {
          "type": "string",
          "enum": [
            "text",
            "number"
          ]
        },
        "normalization_profile": {
          "type": "string",
          "enum": [
            "exact",
            "trim",
            "casefold",
            "trim_casefold",
            "remove_whitespace",
            "remove_whitespace_casefold"
          ]
        },
        "duplicate_policy": {
          "type": "string",
          "enum": [
            "reject",
            "review",
            "first",
            "all"
          ]
        },
        "unmatched_policy": {
          "type": "string",
          "enum": [
            "report",
            "skip",
            "fail"
          ]
        },
        "overwrite_policy": {
          "type": "string",
          "enum": [
            "empty_only",
            "overwrite",
            "review"
          ]
        }
      },
      "required": [
        "source_workbook_path",
        "worksheet",
        "header_row",
        "data_start_row",
        "source_key_column",
        "target_column",
        "match_field",
        "write_field"
      ],
      "default": null
    }
  },
  "required": [
    "detection",
    "ocr",
    "processing"
  ]
}
